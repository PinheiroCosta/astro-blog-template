{
  "name": "astro-blog-template",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,astro}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src eslint.config.js astro.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "astro": "^7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
